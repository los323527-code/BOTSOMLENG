# Required: create two Telegram bots using @BotFather
MAIN_BOT_TOKEN=put_main_bot_token_here
MANAGER_BOT_TOKEN=put_manager_bot_token_here

# Kiritts API key from your Kiri dashboard
KIRI_API_KEY=put_kiritts_api_key_here
KIRI_VOICE=Maly

# Vercel production URL, no trailing slash
APP_BASE_URL=https://your-project.vercel.app

# Generate long random values; do not reuse Telegram tokens
SETUP_SECRET=replace_with_long_random_secret
MAIN_WEBHOOK_SECRET=replace_with_random_telegram_webhook_secret
MANAGER_WEBHOOK_SECRET=replace_with_random_telegram_webhook_secret

# Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=put_generated_fernet_key_here
